+    protected String downloadWithResume(URL source, File target, String digestAlgorithm, int digestLength, String expectedDigest) throws IOException {
+        this.ensureFileWritable(target);
+        long knownTotal = this.expectedSize;
+
+        if (target.isFile() && expectedDigest != null && expectedDigest.length() > 0) {
+            String localDigest = getDigest(target, digestAlgorithm, digestLength);
+            if (expectedDigest.equalsIgnoreCase(localDigest)) {
+                if (knownTotal == 0L) {
+                    knownTotal = target.length();
+                    this.setExpectedSize(knownTotal);
+                }
+                this.monitor.setTotal(knownTotal);
+                this.monitor.setCurrent(target.length());
+                return localDigest;
+            }
+        }
+
+        IOException lastFailure = null;
+        for (int attempt = 1; attempt <= MAX_RESUME_ATTEMPTS; ++attempt) {
+            long offset = target.isFile() ? target.length() : 0L;
+            if (knownTotal > 0L && offset > knownTotal) {
+                if (!target.delete() && target.exists()) {
+                    throw new IOException("Could not delete oversized partial download " + target);
+                }
+                offset = 0L;
+            }
+
+            HttpURLConnection connection = this.makeConnection(source);
+            if (offset > 0L) {
+                connection.setRequestProperty("Range", "bytes=" + offset + "-");
+            }
+
+            InputStream input = null;
+            OutputStream output = null;
+            try {
+                int responseCode = connection.getResponseCode();
+                boolean append;
+                long responseTotal;
+                if (offset > 0L && responseCode == HttpURLConnection.HTTP_PARTIAL) {
+                    responseTotal = parseContentRangeTotal(connection.getHeaderField("Content-Range"), offset);
+                    append = true;
+                    LOGGER.info("Resuming {} at byte {} (connection attempt {}/{})", new Object[]{target, offset, attempt, MAX_RESUME_ATTEMPTS});
+                } else if (responseCode / 100 == 2) {
+                    if (offset > 0L) {
+                        LOGGER.warn("Server ignored byte range for {}; restarting this file from byte zero", target);
+                    }
+                    offset = 0L;
+                    append = false;
+                    responseTotal = (long)connection.getContentLength();
+                } else {
+                    throw new IOException("Server responded with HTTP " + responseCode + " for " + source);
+                }
+
+                if (responseTotal > 0L) {
+                    if (knownTotal > 0L && knownTotal != responseTotal) {
+                        throw new IOException("Server reported size " + responseTotal + " but expected " + knownTotal + " for " + source);
+                    }
+                    knownTotal = responseTotal;
+                    this.setExpectedSize(responseTotal);
+                    this.monitor.setTotal(responseTotal);
+                }
+                this.monitor.setCurrent(offset);
+
+                input = new MonitoringInputStream(connection.getInputStream(), this.monitor);
+                output = new FileOutputStream(target, append);
+                byte[] buffer = new byte[65536];
+
+                for (int read = input.read(buffer); read >= 0; read = input.read(buffer)) {
+                    if (read > 0) {
+                        output.write(buffer, 0, read);
+                    }
+                }
+                output.flush();
+            } catch (IOException failure) {
+                lastFailure = failure;
+                LOGGER.warn(
+                    "Connection attempt {}/{} for {} ended after {} of {} bytes; retaining the partial file for a ranged retry",
+                    new Object[]{attempt, MAX_RESUME_ATTEMPTS, target, target.isFile() ? target.length() : 0L, knownTotal, failure}
+                );
+            } finally {
+                closeSilently(input);
+                closeSilently(output);
+                connection.disconnect();
+            }
+
+            long downloadedSize = target.isFile() ? target.length() : 0L;
+            if (knownTotal > 0L && downloadedSize > knownTotal) {
+                if (!target.delete() && target.exists()) {
+                    throw new IOException("Downloaded file exceeded expected size and could not be deleted: " + target);
+                }
+                throw new IOException("Downloaded file exceeded expected size " + knownTotal + ": " + target);
+            }
+
+            if (knownTotal == 0L || downloadedSize == knownTotal) {
+                if (expectedDigest == null || expectedDigest.length() == 0) {
+                    if (knownTotal > 0L) {
+                        this.monitor.setCurrent(knownTotal);
+                        return "";
+                    }
+                } else {
+                    String actualDigest = getDigest(target, digestAlgorithm, digestLength);
+                    if (expectedDigest.equalsIgnoreCase(actualDigest)) {
+                        if (knownTotal == 0L) {
+                            knownTotal = downloadedSize;
+                            this.setExpectedSize(knownTotal);
+                            this.monitor.setTotal(knownTotal);
+                        }
+                        this.monitor.setCurrent(knownTotal);
+                        return actualDigest;
+                    }
+
+                    if (knownTotal > 0L && downloadedSize == knownTotal) {
+                        if (!target.delete() && target.exists()) {
+                            throw new IOException("Downloaded file had an invalid digest and could not be deleted: " + target);
+                        }
+                        throw new IOException("Downloaded file digest did not match (expected " + expectedDigest + ", downloaded " + actualDigest + ")");
+                    }
+                }
+            }
+
+            if (attempt < MAX_RESUME_ATTEMPTS) {
+                sleepBeforeRetry(attempt);
+            }
+        }
+
+        long finalSize = target.isFile() ? target.length() : 0L;
+        IOException exhausted = new IOException(
+            "Could not finish " + source + " after " + MAX_RESUME_ATTEMPTS + " connections (downloaded " + finalSize + " of " + knownTotal + " bytes)"
+        );
+        if (lastFailure != null) {
+            exhausted.initCause(lastFailure);
+        }
+        throw exhausted;
+    }
+
+    private static long parseContentRangeTotal(String contentRange, long expectedOffset) throws IOException {
+        String expectedPrefix = "bytes " + expectedOffset + "-";
+        if (contentRange == null || !contentRange.toLowerCase().startsWith(expectedPrefix)) {
+            throw new IOException("Invalid Content-Range for resumed download: " + contentRange + " (expected " + expectedPrefix + "...)");
+        }
+
+        int slash = contentRange.lastIndexOf(47);
+        if (slash < 0 || slash == contentRange.length() - 1 || "*".equals(contentRange.substring(slash + 1))) {
+            throw new IOException("Content-Range did not include a usable total size: " + contentRange);
+        }
+
+        try {
+            return Long.parseLong(contentRange.substring(slash + 1));
+        } catch (NumberFormatException invalidTotal) {
+            throw new IOException("Invalid total size in Content-Range: " + contentRange, invalidTotal);
+        }
+    }
+
+    private static void sleepBeforeRetry(int attempt) throws IOException {
+        long delay = Math.min(RETRY_DELAY_MILLIS * (long)attempt, 2000L);
+        try {
+            Thread.sleep(delay);
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new IOException("Interrupted while waiting to retry download", interrupted);
+        }
+    }
+
     public URL getUrl() {
         return this.url;
     }
